__pycache__/
*.pyc
.DS_Store

# Raw fetch output: ~50 MB of auto-captions for 64 videos, and it grows with
# every video. Nothing downstream reads it once the transcript has been
# compressed into kb/videos/<id>.md - keeping it out means a clone of this
# public repo stays small. It's still written locally as an audit trail.
transcripts/

# Audit reports are regenerated local-only artifacts (wiki-audit). The committed record
# of an audit is the `review:` frontmatter token on the audited page, not the report.
wiki/pages/audit-*.md
